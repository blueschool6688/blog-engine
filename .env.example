# Blog Engine — Environment Variables Template
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
APP_URL=http://localhost:5173

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=blogs
DB_SSLMODE=disable

# ─── Cache (Memcached) ────────────────────────────────────────────────────────
MEMCACHED_ADDR=127.0.0.1:11211

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOADS_DIR=./uploads

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ─── Cloudflare Cache Purge (optional) ───────────────────────────────────────
CF_ZONE_ID=
CF_API_TOKEN=

# ─── NVIDIA NIM API (AI Translation) ─────────────────────────────────────────
# Lấy API key tại: https://integrate.api.nvidia.com
# Tính năng dịch thuật VI ↔ EN sẽ không hoạt động nếu để trống
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxx

# Model NVIDIA NIM để dịch nội dung. Các lựa chọn:
#   meta/llama-3.1-70b-instruct       ← Mặc định, đa năng, mạnh
#   meta/llama-3.1-8b-instruct        ← Nhanh hơn, ít tốn quota
#   nvidia/llama-3.1-nemotron-70b-instruct  ← Reasoning mạnh hơn
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Số ký tự tối đa mỗi chunk khi chia nội dung dài để dịch
# Nội dung <= SyncLengthLimit (3000 chars) được xử lý đồng bộ ngay
# Nội dung > 3000 chars được đưa vào async job queue
# Default: 2000 — giảm nếu thấy timeout, tăng nếu muốn ít chunks hơn
TRANSLATE_CHUNK_SIZE=2000
